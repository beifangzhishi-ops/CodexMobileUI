{
  "expo": {
    "name": "CodexMobileUI",
    "slug": "codex-mobile-ui",
    "scheme": "codexmobileui",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dev.codexmobileui.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "extra": {
      "apiClientId": "codexmobileui-android"
    }
  }
}
