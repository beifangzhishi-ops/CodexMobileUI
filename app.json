{
  "expo": {
    "name": "CodexMobileUI",
    "slug": "codex-mobile-ui",
    "scheme": "codexmobileui",
    "version": "0.2.5",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "android": {
      "package": "dev.codexmobileui.app",
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 32,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "./plugins/withPrivateAndroidManifest.cjs"
    ],
    "extra": {
      "apiClientId": "codexmobileui-android"
    }
  }
}
