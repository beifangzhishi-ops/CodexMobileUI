{
  "expo": {
    "name": "CodexMobileUI",
    "slug": "codex-mobile-ui",
    "scheme": "codexmobileui",
    "version": "0.1.6",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "dev.codexmobileui.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 8,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      "expo-speech-recognition"
    ],
    "extra": {
      "apiClientId": "codexmobileui-android"
    }
  }
}
