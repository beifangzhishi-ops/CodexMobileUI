# Configure each host independently. Do not commit actual values.
MOBILE_PUBLIC_ORIGIN=https://your-host.your-tailnet.ts.net:8443
MOBILE_APPROVAL_SECRET=replace-with-a-unique-256-bit-random-hex-secret
MOBILE_REDIRECT_URI=codexmobileui://oauth
MOBILE_GATEWAY_PORT=48888
CODEX_APP_SERVER_WS=ws://127.0.0.1:45891
# Optional: extra host-approved directory roots for the native project picker.
# Separate absolute Windows paths with semicolons. Default roots are Documents/Desktop.
# MOBILE_PROJECT_ROOTS=D:\\Projects;E:\\Work
